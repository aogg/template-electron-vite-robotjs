    "@types/node": "^20.3.3",
    "crypto-js": "^4.1.1",
    "electron-updater": "^6.3.9",
    "element-plus": "^2.3.7",
    "minimatch": "^10.0.3",
    "tailwindcss": "^3.3.2",
    "vue-router": "4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
