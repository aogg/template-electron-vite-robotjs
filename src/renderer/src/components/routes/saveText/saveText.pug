// :rules="rules",
el-form.p-2.h-screen(
    ref="ruleFormRef",
    status-icon,
    :model="ruleForm",

    label-width="22%",
)
    el-form-item(label="标题", prop="label")
        el-input(
            v-model="ruleForm.label", type="text", autocomplete="off", required,
            placeholder="显示用的标题",
        )
    el-form-item(label="发送的文本")
        .w-full(
            v-for="(item, index) in ruleForm.content",
        )
            el-input(
                v-model="item.type", type="hidden"
            )
            el-input(
                v-model="item.text",
                :autosize="{ minRows: 5 }",
                type="textarea",
                placeholder="输入被发送的文本",
            )


    el-form-item
        el-button(type="primary", @click="submitForm()") 提交
        el-button(@click="canalForm()") 取消
